# ============================================================
# OpenSky Network credentials
# Register at https://opensky-network.org/
# ============================================================
OPENSKY_USERNAME=your_username_here
OPENSKY_PASSWORD=your_password_here

# ============================================================
# Geographic bounding box (MENA + transit corridors)
# Latitude: south to north
# Longitude: west to east
# ============================================================
BBOX_LAMIN=12.0
BBOX_LAMAX=42.0
BBOX_LOMIN=25.0
BBOX_LOMAX=65.0

# ============================================================
# Lakehouse root
# Local: ./data
# Azure (Week 4): abfss://container@account.dfs.core.windows.net
# ============================================================
LAKE_ROOT=./data

# ============================================================
# Airflow metadata database
# Used internally by Airflow — do not change unless you know why
# ============================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ============================================================
# Airflow admin user (first-time setup only)
# ============================================================
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ============================================================
# Azure / ADLS Gen2 credentials (Week 4 — leave empty for now)
# ============================================================
AZURE_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=